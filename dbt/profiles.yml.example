# run dbt with: dbt run --profiles-dir .
# copy this file to profiles.yml and set the env vars listed below (or override here for local use)
nextbike:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_DB_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_DB_PORT', '5432') | int }}"
      user: "{{ env_var('DBT_DB_USER', 'nextbike') }}"
      password: "{{ env_var('DBT_DB_PASS', 'nextbike') }}"
      dbname: "{{ env_var('DBT_DB_NAME', 'nextbike') }}"
      schema: dbt_dev
      threads: 4
